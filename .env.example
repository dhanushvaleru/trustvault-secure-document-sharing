# TrustVault Environment Configuration Example

# Database: SQLite for local zero-config, PostgreSQL for production
# Local SQLite:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustvault?schema=public"

PORT=5000
NODE_ENV=development
SESSION_SECRET="change-this-to-a-cryptographically-random-secret-in-production-min-32-chars"
COOKIE_SECURE=false
STORAGE_DIR="../storage"

# Security and Feature Flags
REGISTRATION_ENABLED=true
DEMO_ACCOUNTS_ENABLED=true
SESSION_TTL_HOURS=8
IDLE_TIMEOUT_MINUTES=60
MAX_FILE_SIZE_BYTES=10485760
